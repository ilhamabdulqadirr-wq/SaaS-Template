{
  "name": "saas-landing-page-template",
  "version": "1.0.0",
  "description": "Responsive SaaS landing page template with Tailwind CSS and Alpine.js",
  "main": "src/main.js",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./dist/assets/output.css --watch",
    "build": "npx tailwindcss -i ./src/input.css -o ./dist/assets/output.css --minify"
  },
  "keywords": [
    "saas",
    "landing-page",
    "tailwind",
    "alpinejs",
    "template",
    "gumroad"
  ],
  "author": "Template Author",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
